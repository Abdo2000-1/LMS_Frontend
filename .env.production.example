# Production environment variables (copy to .env.production before building)
# Vite inlines these at build time — rebuild after changing values.

# Azure App Service API URL (no trailing slash)
VITE_API_BASE_URL=https://YOUR_APP_SERVICE.azurewebsites.net

# Optional: override Vite base path for Azure Static Web Apps (default: /)
# VITE_BASE_PATH=/
